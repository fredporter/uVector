        { "name": "yellow", "hex": "#F4B41B" },
        { "name": "lime", "hex": "#56C639" },
        { "name": "sky_blue", "hex": "#3CB0E8" },
        { "name": "indigo", "hex": "#6850A4" },
        { "name": "pink", "hex": "#E85E8C" },
        { "name": "peach", "hex": "#F4B896" }
