{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uVector Canonical Palette Registry",
  "version": "1.0.0",
  "source_of_truth": "uVector",
  "description": "Canonical bundled color palettes and customization definitions for uDos ecosystem. uCore and uCode consume base presets only.",
  "palettes": {
    "teletext_ceefax": {
      "id": "teletext_ceefax",
      "name": "Teletext Ceefax",
      "description": "8-color broadcast teletext standard palette",
      "base_preset": true,
      "colors": [
        { "name": "black", "hex": "#000000", "ansi": 30 },
        { "name": "red", "hex": "#E6193C", "ansi": 31 },
        { "name": "green", "hex": "#3FB950", "ansi": 32 },
        { "name": "yellow", "hex": "#F2CC60", "ansi": 33 },
        { "name": "blue", "hex": "#58A6FF", "ansi": 34 },
        { "name": "magenta", "hex": "#BC8CFF", "ansi": 35 },
        { "name": "cyan", "hex": "#39C5CF", "ansi": 36 },
        { "name": "white", "hex": "#FFFFFF", "ansi": 37 }
      ]
    },
    "architectural_blueprint": {
      "id": "architectural_blueprint",
      "name": "Architectural Blueprint",
      "description": "Crisp white and electric cyan drafting linework on deep Prussian blue substrate",
      "base_preset": true,
      "colors": [
        { "name": "prussian_blue", "hex": "#0A2342", "role": "substrate" },
        { "name": "electric_cyan", "hex": "#00E5FF", "role": "primary_line" },
        { "name": "pale_cyan", "hex": "#A6F0FF", "role": "secondary_line" },
        { "name": "drafting_white", "hex": "#FFFFFF", "role": "highlight" }
      ]
    },
    "editorial_linocut": {
      "id": "editorial_linocut",
      "name": "Editorial Linocut Paper",
      "description": "Black woodcut ink and stipple on archival cream paper",
      "base_preset": true,
      "colors": [
        { "name": "archival_cream", "hex": "#FAF8F5", "role": "substrate" },
        { "name": "carbon_ink", "hex": "#111111", "role": "primary_ink" },
        { "name": "charcoal_stipple", "hex": "#2D3139", "role": "shade" },
        { "name": "pure_white", "hex": "#FFFDF8", "role": "substrate_highlight" }
      ]
    },
    "pixel_16": {
      "id": "pixel_16",
